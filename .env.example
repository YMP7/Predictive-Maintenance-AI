# AI Agent Configuration
MACHINE_ID=M001
MACHINE_TYPE=Lathe
MACHINE_LOCATION=Section A

# Simulation Configuration
SIMULATION_INTERVAL=1
SIMULATION_ENABLED=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# JWT Authentication (REQUIRED — the app will NOT start without this)
# Generate a secret with:  openssl rand -hex 32
JWT_SECRET_KEY=

# Mobile/Lumia telemetry bridge token (bridge rejects all pushes while unset)
# Open the bridge on the phone as  http://<host>/lumia#token=<this value>
MOBILE_BRIDGE_TOKEN=

# CORS Allowed Origins (comma-separated list of frontend URLs)
# If unset, defaults to http://localhost:3000 (dev only).
# In production, set this to your actual deployed frontend URL.
CORS_ORIGINS=http://localhost:3000

# Dashboard Configuration
DASHBOARD_PORT=3000
DASHBOARD_REFRESH_INTERVAL=2000

# Alert Configuration
ALERT_COOLDOWN=300
ALERT_LANGUAGES=en,hi,te,ta,mr

# ── Notification Integration (Phase 5) ────────────────────────────
# Set NOTIFICATIONS_ENABLED=true to dispatch SMS/email/voice for Critical/High alerts.
# When false (default), alerts are logged to dashboard only — no external creds needed.
# IMPORTANT: If NOTIFICATIONS_ENABLED=true, ALL credentials below are REQUIRED.
# The server will refuse to start if any are missing (fail-loud pattern).
NOTIFICATIONS_ENABLED=false

# Twilio (SMS + Voice calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# SMTP (Email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_USE_TLS=true
ALERT_EMAIL_TO=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/agent.log

# MQTT Ingestion Configuration (Backend Service Creds)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=backend_service
MQTT_PASSWORD=backend_secret
MQTT_TLS_ENABLED=false

# Note: Edge devices must use their per-device credentials for publishing.
# E.g., MQTT_USERNAME=device_M001, MQTT_PASSWORD=m001_secret

# TimescaleDB (REQUIRED — the app will NOT start without this)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://dtwin:CHANGE_ME@localhost:5432/digital_twin
TSDB_USER=dtwin
TSDB_PASSWORD=CHANGE_ME

# Application Environment (controls dev-only features like seed_dev.py)
APP_ENV=development

# ── Seed / bootstrap users (scripts/seed_dev.py) ──────────────────
# Generate hashes with the project's get_password_hash helper (server/auth.py)
ADMIN_EMAIL=admin@digitaltwin.local
ADMIN_PHONE=
ADMIN_PASSWORD_HASH=
OPERATOR_PASSWORD_HASH=

# ── Deployment environment ────────────────────────────────────────
ENVIRONMENT=development

# ── Gemini LLM agent (optional; off by default) ───────────────────
GEMINI_AGENT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── MQTT broker passwords (scripts/generate_mqtt_passwords.py) ────
MQTT_BACKEND_PASSWORD=backend_secret
MQTT_M001_PASSWORD=m001_secret
MQTT_M002_PASSWORD=m002_secret
MQTT_M003_PASSWORD=m003_secret
MQTT_M004_PASSWORD=m004_secret

# ── Remote server adapter over SSH (optional) ─────────────────────
SSH_SERVER_HOST=
SSH_SERVER_PORT=22
SSH_SERVER_USER=root
SSH_SERVER_PASSWORD=
SSH_SERVER_KEY_FILE=

# ── Mobile adapter / Termux bridge (optional) ─────────────────────
TERMUX_API_URL=http://127.0.0.1:8088
TERMUX_BRIDGE_PORT=8088
TERMUX_WIFI_URL=

# ── Misc ──────────────────────────────────────────────────────────
# Work around duplicate OpenMP runtime crash (torch + numpy on Windows)
KMP_DUPLICATE_LIB_OK=TRUE

# ── Frontend (client/, Vite) ──────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
